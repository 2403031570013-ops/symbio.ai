# Database Configuration
DATABASE_URL=mongodb+srv://user:pass@localhost/symbioai?retryWrites=true&w=majority
DATABASE_NAME=symbioai

# JWT Configuration
SECRET_KEY=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Environment
ENVIRONMENT=development
SECURE_COOKIES=false

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email Configuration (Resend - Recommended)
RESEND_API_KEY=
OTP_PROVIDER=resend

# Alternative SMTP Configuration (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@symbioai.com
SMTP_USE_TLS=true

# Development OTP Codes (for testing)
DEV_EMAIL_OTP=654321
DEV_MOBILE_OTP=123456
DEV_FACTORY_CODE=123456

# Factory Verification
FACTORY_VERIFICATION_CODE=SYMBIO2024

# Admin Secret (Development only)
ADMIN_DEV_SECRET=

# Storage Configuration (S3)
STORAGE_PROVIDER=s3
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=
S3_PUBLIC_BASE_URL=

# OpenAI Configuration (Optional)
OPENAI_API_KEY=

# Rate Limiting
RATE_LIMIT_PER_MINUTE=120
